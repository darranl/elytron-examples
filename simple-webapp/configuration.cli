#/subsystem=logging/logger=io.undertow:add(level=TRACE)
/subsystem=logging/logger=org.wildfly.security:add(level=TRACE)

/system-property=java.security.krb5.conf:add(value=/home/darranl/krb5.conf)

/subsystem=elytron/regex-principal-transformer=realm-stripper:add(pattern="@ELYTRON.ORG", replacement="")

/subsystem=elytron/kerberos-security-factory=wildfly:add(path="/home/darranl/Customer/EAPSUP-2043/Reproducer/wildfly.keytab", \
     principal="HTTP/wildfly.elytron.org@ELYTRON.ORG", obtain-kerberos-ticket=true, debug=true, \
     mechanism-oids=[1.2.840.113554.1.2.2, 1.3.6.1.5.5.2], minimum-remaining-lifetime=86100)

/subsystem=elytron/http-authentication-factory=krb-http-auth:add(http-server-mechanism-factory=global, security-domain=ApplicationDomain, \
    mechanism-configurations=[{mechanism-name=SPNEGO, credential-security-factory=wildfly, pre-realm-principal-transformer=realm-stripper}])

# Note: we override deployment congig so deployment asks for BASIC and gets SPNEGO
/subsystem=undertow/application-security-domain=other:add(http-authentication-factory=krb-http-auth, override-deployment-config=true)

